[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://bin/libmb_godot.dylib"
macos.release = "res://bin/libmb_godot.dylib"
linux.debug.x86_64 = "res://bin/libmb_godot.so"
linux.release.x86_64 = "res://bin/libmb_godot.so"
windows.debug.x86_64 = "res://bin/mb_godot.dll"
windows.release.x86_64 = "res://bin/mb_godot.dll"
